# Per-author corpus workspaces: state, notes, stripped text, prompts, archive,
# overrides, validation, and any local-only built skill. Never committed.
corpora/

# Local-only corpora and profiles (e.g. another author's voice), merged over
# profiles.yaml by paths.py.
profiles.local.yaml

# Legacy root-level locations (pre-corpora layout)
corpus_state.yaml
 
# Generated LLM session prompts — assembled at runtime by skill.py, land in /prompts
# Pattern: bootstrap_prompt_YYYY-MM-DD.md, refinement_prompt_DOCID+DOCID_YYYY-MM-DD.md
prompts/
 
# Stray root output (skill.py writes here only for a profile with no `output`).
# Built skills under skills/<profile>/ ARE tracked: they are the canonical source.
/SKILL.md
# Derived browser/paste test copies of a built skill — also generated output
*_browser.md
 
# Auto-generated working directories
batch_notes/
stripped_text/

# Achive directory populated from past iterations
archive/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
 
# macOS
.DS_Store
 
# Editor
.vscode/
.idea/
*~

*.txt

# Claude Code: ignore local settings, but TRACK project skills — the
# project skills is load-bearing pipeline machinery.
.claude/*
!.claude/skills/
!.claude/skills/**
.claude/settings.local.json

overrides.yaml
# ...except dependency lists
!requirements.txt
